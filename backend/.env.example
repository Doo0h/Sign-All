# Node.js 24.x / backend 폴더에서 실행
HOST=127.0.0.1
PORT=3001
DB_PATH=./var/signall.sqlite
# demo: 가상 기업·직무와 규칙 기반 응답 / live: 확보한 데이터·실제 AI
APP_MODE=demo
# 프론트 개발 주소. 그 외 Origin을 가진 브라우저 요청은 거절
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=500
MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=30
MAX_AI_CONCURRENT=2
MAX_AI_CALLS_PER_HOUR=100
AI_TIMEOUT_MS=20000
# live 모드 전용: HTTPS chat-completions 호환 전체 URL, 키, 모델
AI_API_URL=
AI_API_KEY=
AI_MODEL=
