# Node.js 24.x / backend 폴더에서 실행
HOST=127.0.0.1
PORT=3001
DB_PATH=./var/signall.sqlite
# demo: 가상 기업·직무와 규칙 기반 응답 / live: 확보한 데이터·실제 AI
APP_MODE=demo
# 공식 기업·사전 링크와 팀 작성 연습 기준을 사용하려면 다음 두 줄을 설정
# REFERENCE_MODE=live
# REFERENCE_DATA_PATH=../data/reference-starter.json
# 파일 추출: 로컬 Python 의존성 설치 필요, Docker는 포함
MAX_UPLOAD_BYTES=5242880
# PYTHON_BIN=python
# 프론트 개발 주소. 그 외 Origin을 가진 브라우저 요청은 거절
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=500
MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=30
MAX_AI_CONCURRENT=2
MAX_AI_CALLS_PER_HOUR=100
AI_TIMEOUT_MS=20000
# live 모드 전용: HTTPS chat-completions 호환 전체 URL, 키, 모델
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# 무료 외부 AI 후보: AI_PROVIDER=groq, AI_MODEL=openai/gpt-oss-20b
# Groq Free Plan의 키를 AI_API_KEY에 직접 설정. 키를 Git에 올리지 않습니다.

# 무료 로컬 실행 선택: AI_PROVIDER=ollama (외부 API 사용은 external)
# Ollama 설치와 로컬 모델 다운로드는 별도 작업입니다.
# APP_MODE=live
# AI_PROVIDER=ollama
# AI_API_URL=http://127.0.0.1:11434/v1/chat/completions
# AI_MODEL=설치한_로컬_모델명
# AI_API_KEY는 로컬 Ollama에서 불필요합니다.
# 서비스 live 질문에는 검증된 참조자료 DB도 필요합니다.
